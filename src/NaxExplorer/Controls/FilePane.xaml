<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NaxExplorer.Controls.FilePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NaxExplorer"
    xmlns:m="using:NaxExplorer.Models">

    <UserControl.Resources>
        <!-- Selected rows get a clear blue background, so several selected files are easy to tell apart. These keys
             replace the list's own faint grey for every row inside the pane. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#403B82F6" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#553B82F6" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#663B82F6" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#403B82F6" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#553B82F6" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#663B82F6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#663B82F6" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#803B82F6" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#993B82F6" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#663B82F6" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#803B82F6" />
                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#993B82F6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <!-- One row of the details view. Column widths are set from code, so the header and the rows line up. -->
        <DataTemplate x:Key="DetailsTemplate" x:DataType="m:FileItem">
            <Grid Height="30" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Source="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <!-- The cloud status of a file in a sync folder, on the corner of its icon as in Explorer. -->
                <FontIcon Glyph="{x:Bind CloudGlyph, Mode=OneWay}" FontSize="10" Foreground="{x:Bind CloudBrush, Mode=OneWay}" Visibility="{x:Bind CloudVisibility, Mode=OneWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" ToolTipService.ToolTip="{x:Bind CloudText, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Margin="6,0,8,0" Text="{x:Bind DisplayName, Mode=OneWay}" Foreground="{x:Bind NameBrush, Mode=OneWay}"
                           Visibility="{x:Bind NameVisibility, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                <TextBox x:Name="RenameBox" Grid.Column="1" Margin="0,1,8,1" Padding="6,3" MinHeight="26" FontSize="13"
                         x:Load="{x:Bind IsRenaming, Mode=OneWay}" Text="{x:Bind Entry.Name}"
                         Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                <TextBlock Grid.Column="2" Margin="8,0" Text="{x:Bind DateText, Mode=OneWay}" Style="{StaticResource SecondaryCellTextStyle}" />
                <TextBlock Grid.Column="3" Margin="8,0" Text="{x:Bind TypeText, Mode=OneWay}" Style="{StaticResource SecondaryCellTextStyle}" />
                <Grid Grid.Column="4" Margin="8,0,12,0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind SizeTip, Mode=OneWay}">
                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource SecondaryCellTextStyle}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Drives on "This PC": a usage bar under the name. -->
        <DataTemplate x:Key="DriveTemplate" x:DataType="m:FileItem">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="28" Height="28" Source="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0" Spacing="6">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource CellTextStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource SecondaryCellTextStyle}" />
                    </Grid>
                    <ProgressBar Value="{x:Bind UsedFraction, Mode=OneWay}" Maximum="1" Height="6" CornerRadius="3" HorizontalAlignment="Stretch"
                                 Foreground="{x:Bind UsageBrush, Mode=OneWay}" Visibility="{x:Bind UsageVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A search result: name with the ways it matched, the text around the match, and its folder. -->
        <DataTemplate x:Key="ResultTemplate" x:DataType="m:FileItem">
            <Grid MinHeight="46" Padding="0,5" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Source="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <FontIcon Glyph="{x:Bind CloudGlyph}" FontSize="10" Foreground="{x:Bind CloudBrush}" Visibility="{x:Bind CloudVisibility}"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,0,0" ToolTipService.ToolTip="{x:Bind CloudText}" />
                <StackPanel Grid.Column="1" Margin="6,0,8,0" Spacing="1">
                    <!-- The name gives way before the badges that say why the file was found. -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Foreground="{x:Bind NameBrush, Mode=OneWay}" Style="{StaticResource CellTextStyle}" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Border Visibility="{x:Bind NameBadgeVisibility}" CornerRadius="8" Padding="6,0" Background="#333B82F6" VerticalAlignment="Center">
                                <TextBlock Text="{local:T Key=MatchName}" FontSize="10" Foreground="#3B82F6" />
                            </Border>
                            <Border Visibility="{x:Bind WordsBadgeVisibility}" CornerRadius="8" Padding="6,0" Background="#3310B981" VerticalAlignment="Center">
                                <TextBlock Text="{local:T Key=MatchWords}" FontSize="10" Foreground="#10B981" />
                            </Border>
                            <Border Visibility="{x:Bind MeaningBadgeVisibility}" CornerRadius="8" Padding="6,0" Background="#338B5CF6" VerticalAlignment="Center">
                                <TextBlock Text="{local:T Key=MatchMeaning}" FontSize="10" Foreground="#A78BFA" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SnippetText" Visibility="{x:Bind SnippetVisibility}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind FolderText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="8,2,8,0" VerticalAlignment="Top" Text="{x:Bind DateText}" Style="{StaticResource SecondaryCellTextStyle}" />
                <TextBlock Grid.Column="3" Margin="8,2,12,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{x:Bind SizeText}" Style="{StaticResource SecondaryCellTextStyle}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ThumbnailTemplate" x:DataType="m:FileItem">
            <Grid Width="150" Height="172" Padding="6" RowSpacing="6" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="118" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" MaxWidth="138" MaxHeight="118" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <FontIcon Glyph="{x:Bind CloudGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind CloudBrush, Mode=OneWay}" Visibility="{x:Bind CloudVisibility, Mode=OneWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" ToolTipService.ToolTip="{x:Bind CloudText, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Text="{x:Bind DisplayName, Mode=OneWay}" Foreground="{x:Bind NameBrush, Mode=OneWay}" Visibility="{x:Bind NameVisibility, Mode=OneWay}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" HorizontalAlignment="Center" />
                <TextBox x:Name="RenameBox" Grid.Row="1" x:Load="{x:Bind IsRenaming, Mode=OneWay}" Text="{x:Bind Entry.Name}" FontSize="12" Padding="4,2" MinHeight="24"
                         Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{ThemeResource PaneBackgroundBrush}" CornerRadius="8" BorderThickness="1"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" GotFocus="Root_GotFocus" PointerPressed="Root_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The lighter background of the active pane, as a theme resource so it follows a light or dark window. -->
        <Border x:Name="ActiveBackground" Grid.RowSpan="6" CornerRadius="8" Background="{ThemeResource ActivePaneBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />

        <Rectangle x:Name="ActiveBar" Height="3" VerticalAlignment="Top" Fill="{StaticResource NaxGradientBrush}" Opacity="0" RadiusX="2" RadiusY="2" Margin="10,0" />

        <TabView x:Name="Tabs" Grid.Row="0" Margin="4,4,4,0" TabWidthMode="SizeToContent" CanReorderTabs="True" CanDragTabs="False"
                 IsAddTabButtonVisible="True" AddTabButtonClick="Tabs_AddTabButtonClick" TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged" VerticalAlignment="Top" />

        <!-- Navigation, address and search. -->
        <Grid Grid.Row="1" Padding="6,4,6,4" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="80" />
                <ColumnDefinition Width="*" MaxWidth="250" MinWidth="110" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource ToolbarButtonStyle}" Click="Back_Click" AutomationProperties.Name="{local:T Key=BackTip}" ToolTipService.ToolTip="{local:T Key=BackTip}">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="Forward_Click" AutomationProperties.Name="{local:T Key=ForwardTip}" ToolTipService.ToolTip="{local:T Key=ForwardTip}">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="Up_Click" AutomationProperties.Name="{local:T Key=UpTip}" ToolTipService.ToolTip="{local:T Key=UpTip}">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="{local:T Key=RefreshTip}" ToolTipService.ToolTip="{local:T Key=RefreshTip}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>

            <Grid x:Name="AddressArea" Grid.Column="4" Margin="6,0" MinHeight="32">
                <Border x:Name="AddressBack" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Tapped="AddressBack_Tapped" />
                <ScrollViewer x:Name="BreadcrumbScroller" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled" Margin="6,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <BreadcrumbBar x:Name="Breadcrumb" ItemClicked="Breadcrumb_ItemClicked" VerticalAlignment="Center" />
                </ScrollViewer>
                <AutoSuggestBox x:Name="AddressBox" Visibility="Collapsed" VerticalAlignment="Center" QuerySubmitted="AddressBox_QuerySubmitted"
                                TextChanged="AddressBox_TextChanged" KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus" UpdateTextOnSelect="True" />
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Column="5" VerticalAlignment="Center" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" PlaceholderText="{local:T Key=SearchPlaceholder}" ToolTipService.ToolTip="{local:T Key=SearchBoxTip}"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" GotFocus="SearchBox_GotFocus" />
        </Grid>

        <!-- Search options and progress, shown while a search is open. -->
        <Grid x:Name="SearchBar" Grid.Row="2" Padding="10,2,8,6" ColumnSpacing="6" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="SmartToggle" AutomationProperties.Name="{local:T Key=SmartSearch}" Click="SmartToggle_Click" Padding="10,4" CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="#A78BFA" />
                        <TextBlock Text="{local:T Key=SmartSearch}" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ExactToggle" AutomationProperties.Name="{local:T Key=ExactSearch}" Click="ExactToggle_Click" Padding="10,4" CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                        <TextBlock Text="{local:T Key=ExactSearch}" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel x:Name="ExactOptions" Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                <CheckBox x:Name="NamesCheck" Content="{local:T Key=InNames}" MinWidth="0" Click="SearchOption_Click" />
                <CheckBox x:Name="ContentsCheck" Content="{local:T Key=InContents}" MinWidth="0" Click="SearchOption_Click" />
                <CheckBox x:Name="SubfoldersCheck" Content="{local:T Key=InSubfolders}" MinWidth="0" Click="SearchOption_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                <ProgressRing x:Name="SearchRing" Width="16" Height="16" IsActive="False" />
                <TextBlock x:Name="SearchStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="StopSearchButton" Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Click="StopSearch_Click" AutomationProperties.Name="{local:T Key=StopSearch}" ToolTipService.ToolTip="{local:T Key=StopSearch}">
                <FontIcon Glyph="&#xE71A;" FontSize="12" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ToolbarButtonStyle}" Click="CloseSearch_Click" AutomationProperties.Name="{local:T Key=CloseSearch}" ToolTipService.ToolTip="{local:T Key=CloseSearch}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- Column headers of the details view. -->
        <Grid x:Name="ColumnHeader" Grid.Row="3" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DateColumn" Width="130" />
                <ColumnDefinition x:Name="TypeColumn" Width="130" />
                <ColumnDefinition x:Name="SizeColumn" Width="90" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NameHeader" Grid.Column="1" Padding="6,4,8,4" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" Tag="Name" />
            <Button x:Name="DateHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" Tag="Modified" />
            <Button x:Name="TypeHeader" Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" Tag="Type" />
            <Button x:Name="SizeHeader" Grid.Column="4" Padding="8,4,12,4" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" Tag="Size" HorizontalContentAlignment="Right" />
            <Rectangle Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <Grid Grid.Row="4" x:Name="ContentArea" SizeChanged="ContentArea_SizeChanged" AllowDrop="True" DragOver="Content_DragOver" Drop="Content_Drop" Background="Transparent"
              RightTapped="Content_RightTapped">
            <ListView x:Name="List" SelectionMode="Extended" IsItemClickEnabled="False" ItemTemplate="{StaticResource DetailsTemplate}"
                      ItemContainerStyle="{StaticResource CompactListViewItemStyle}" Padding="4,2,4,8"
                      CanDragItems="True" DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted"
                      ContainerContentChanging="List_ContainerContentChanging" SelectionChanged="List_SelectionChanged"
                      DoubleTapped="List_DoubleTapped" RightTapped="List_RightTapped" CharacterReceived="List_CharacterReceived"
                      KeyDown="List_KeyDown" />
            <GridView x:Name="Thumbs" Visibility="Collapsed" SelectionMode="Extended" IsItemClickEnabled="False" ItemTemplate="{StaticResource ThumbnailTemplate}"
                      Padding="8,4,8,8" CanDragItems="True" DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted"
                      ContainerContentChanging="List_ContainerContentChanging" SelectionChanged="List_SelectionChanged"
                      DoubleTapped="List_DoubleTapped" RightTapped="List_RightTapped" CharacterReceived="List_CharacterReceived" KeyDown="List_KeyDown" />
            <!-- The selection box drawn while the mouse is dragged over the empty part of the list. -->
            <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" />
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="420">
                <FontIcon x:Name="EmptyGlyph" Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="AddToIndexButton" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed" Click="AddToIndex_Click" />
            <ProgressBar x:Name="LoadingBar" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" Margin="8,0" />
        </Grid>

        <!-- Status line and view switch. -->
        <Grid Grid.Row="5" Padding="12,0,6,4" ColumnSpacing="6" MinHeight="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <Border x:Name="EngineBadge" Grid.Column="1" CornerRadius="9" Padding="8,1" Background="{StaticResource NaxGradientBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="EngineText" FontSize="11" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                <ToggleButton x:Name="DetailsToggle" Padding="6,3" Click="DetailsToggle_Click" AutomationProperties.Name="{local:T Key=ViewDetails}" ToolTipService.ToolTip="{local:T Key=ViewDetails}" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="ThumbsToggle" Padding="6,3" Click="ThumbsToggle_Click" AutomationProperties.Name="{local:T Key=ViewThumbnails}" ToolTipService.ToolTip="{local:T Key=ViewThumbnails}" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8B9;" FontSize="13" />
                </ToggleButton>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
