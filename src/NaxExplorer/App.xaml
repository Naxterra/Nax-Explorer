<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NaxExplorer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ActivePaneBackgroundBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="SnippetMarkBrush" Color="#33FFB000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#4D1C1C1C" />
                    <SolidColorBrush x:Key="ActivePaneBackgroundBrush" Color="#B3202020" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#FF0E0E0E" />
                    <SolidColorBrush x:Key="SnippetMarkBrush" Color="#55FFB000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The accent gradient used for the active pane, the AI badge and the app's highlights. -->
            <LinearGradientBrush x:Key="NaxGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#3B82F6" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="0.5" />
                <GradientStop Color="#EC4899" Offset="1" />
            </LinearGradientBrush>

            <!-- Column headers of the file list: flat buttons that sort by their column. -->
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="SecondaryCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="12,14,0,4" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <Style x:Key="CompactListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="4,0,8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SidebarItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,0,8,0" />
                <Setter Property="Margin" Value="4,0,4,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
